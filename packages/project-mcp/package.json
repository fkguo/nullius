{
  "name": "@nullius/project-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "Project-bound MCP transport for the existing Nullius control plane",
  "type": "module",
  "main": "dist/adapter.js",
  "types": "dist/adapter.d.ts",
  "bin": { "nullius-project-mcp": "dist/index.js" },
  "scripts": {
    "prebuild": "node ../../scripts/ensure-workspace-package-artifacts.mjs @nullius/orchestrator @nullius/shared",
    "build": "tsc",
    "pretest": "pnpm build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@nullius/orchestrator": "workspace:^",
    "@nullius/shared": "workspace:^",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
