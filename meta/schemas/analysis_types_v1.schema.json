{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullius.dev/schemas/analysis_types_v1.schema.json",
  "title": "Analysis Types V1",
  "description": "Consolidated analysis parameter and result types for HEP research tools. Replaces 7 versioned analysis-params/results files.",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "PaperSummaryRef": {
      "type": "object",
      "properties": {
        "recid": {
          "type": "string"
        },
        "arxiv_id": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "openalex_id": {
          "type": "string"
        },
        "zotero_key": {
          "type": "string"
        },
        "texkey": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "collaborations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "number"
        },
        "earliest_date": {
          "type": "string"
        },
        "citation_count": {
          "type": "number"
        },
        "citation_count_without_self_citations": {
          "type": "number"
        },
        "publication_summary": {
          "type": "string"
        },
        "inspire_url": {
          "type": "string",
          "format": "uri"
        },
        "arxiv_url": {
          "type": "string",
          "format": "uri"
        },
        "doi_url": {
          "type": "string",
          "format": "uri"
        },
        "pdf_url": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "publication_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "document_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arxiv_primary_category": {
          "type": "string"
        },
        "arxiv_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "authors"
      ],
      "additionalProperties": false,
      "description": "Paper metadata returned in analysis results, with the same fields as the shared PaperSummary schema."
    },
    "AnalysisType": {
      "type": "string",
      "enum": ["overview", "timeline", "authors", "topics", "all"]
    },
    "RelatedStrategy": {
      "type": "string",
      "enum": ["high_cited_refs", "common_refs", "citing_overlap", "co_citation", "all"]
    },
    "ExpansionDirection": {
      "type": "string",
      "enum": ["forward", "backward", "lateral", "all"]
    },
    "SurveyGoal": {
      "type": "string",
      "enum": ["comprehensive_review", "quick_overview", "find_methods", "historical_context"]
    },
    "SurveyPrioritize": {
      "type": "string",
      "enum": ["citations", "recency", "relevance"]
    },
    "SurveyPriority": {
      "type": "string",
      "enum": ["essential", "recommended", "optional"]
    },
    "TopicTrend": {
      "type": "string",
      "enum": ["growing", "stable", "declining"]
    },
    "ImportStatus": {
      "type": "string",
      "enum": ["imported", "skipped", "failed"]
    },
    "AnalyzePapersParams": {
      "type": "object",
      "required": ["recids"],
      "properties": {
        "recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "analysis_type": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnalysisType" },
          "default": ["all"]
        }
      },
      "additionalProperties": false
    },
    "AnalyzeCollectionParams": {
      "type": "object",
      "required": ["collectionKey"],
      "properties": {
        "collectionKey": { "type": "string", "minLength": 1 },
        "group_id": { "type": "integer" },
        "analysis_type": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnalysisType" },
          "default": ["all"]
        },
        "max_items": { "type": "integer", "minimum": 1, "default": 100 }
      },
      "additionalProperties": false
    },
    "FindConnectionsParams": {
      "type": "object",
      "required": ["recids"],
      "properties": {
        "recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "include_external": { "type": "boolean", "default": false },
        "max_external_depth": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "additionalProperties": false
    },
    "FindRelatedParams": {
      "type": "object",
      "required": ["recids", "strategy"],
      "properties": {
        "recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "strategy": { "$ref": "#/$defs/RelatedStrategy" },
        "limit": { "type": "integer", "minimum": 1, "default": 20 },
        "min_relevance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 }
      },
      "additionalProperties": false
    },
    "ResearchExpansionParams": {
      "type": "object",
      "required": ["seed_recids", "direction"],
      "properties": {
        "seed_recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "direction": { "$ref": "#/$defs/ExpansionDirection" },
        "depth": { "type": "integer", "minimum": 1, "default": 2 },
        "max_results": { "type": "integer", "minimum": 1, "default": 30 },
        "filters": {
          "type": "object",
          "properties": {
            "min_citations": { "type": "integer" },
            "year_range": {
              "type": "object",
              "properties": {
                "start": { "type": "integer" },
                "end": { "type": "integer" }
              },
              "additionalProperties": false
            },
            "exclude_in_library": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "GenerateSurveyParams": {
      "type": "object",
      "required": ["seed_recids", "goal"],
      "properties": {
        "seed_recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "goal": { "$ref": "#/$defs/SurveyGoal" },
        "max_papers": { "type": "integer", "minimum": 5 },
        "prioritize": { "$ref": "#/$defs/SurveyPrioritize", "default": "relevance" },
        "include_reviews": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "TopicEvolutionParams": {
      "type": "object",
      "required": [
        "topic"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "start_year": {
          "type": "integer",
          "minimum": 1900
        },
        "end_year": {
          "type": "integer"
        },
        "granularity": {
          "type": "string",
          "enum": [
            "year",
            "5year",
            "decade"
          ],
          "default": "5year"
        }
      },
      "additionalProperties": false
    },
    "BatchImportParams": {
      "type": "object",
      "required": ["recids"],
      "properties": {
        "recids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "target_collection": { "type": "string" },
        "group_id": { "type": "integer" },
        "auto_create_collection": { "type": "string" },
        "download_pdf": { "type": "boolean", "default": true },
        "add_tag": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CollectionAnalysis": {
      "type": "object",
      "required": ["item_count", "date_range"],
      "properties": {
        "item_count": { "type": "number" },
        "date_range": {
          "type": "object",
          "required": ["earliest", "latest"],
          "properties": {
            "earliest": { "type": "string" },
            "latest": { "type": "string" }
          },
          "additionalProperties": false
        },
        "overview": {
          "type": "object",
          "required": ["total_citations", "avg_citations", "top_cited", "collaborations", "arxiv_categories"],
          "properties": {
            "total_citations": { "type": "number" },
            "avg_citations": { "type": "number" },
            "top_cited": { "type": "array", "items": { "$ref": "#/$defs/PaperSummaryRef" } },
            "collaborations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "count"],
                "properties": {
                  "name": { "type": "string" },
                  "count": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "arxiv_categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["category", "count"],
                "properties": {
                  "category": { "type": "string" },
                  "count": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year", "count", "key_papers"],
            "properties": {
              "year": { "type": "number" },
              "count": { "type": "number" },
              "key_papers": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "paper_count", "total_citations"],
            "properties": {
              "name": { "type": "string" },
              "paper_count": { "type": "number" },
              "total_citations": { "type": "number" },
              "bai": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["keywords", "paper_count", "representative_papers"],
            "properties": {
              "keywords": { "type": "array", "items": { "type": "string" } },
              "paper_count": { "type": "number" },
              "representative_papers": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ConnectionsResult": {
      "type": "object",
      "required": ["internal_edges", "bridge_papers", "isolated_papers"],
      "properties": {
        "internal_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "bridge_papers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recid", "title", "connections"],
            "properties": {
              "recid": { "type": "string" },
              "title": { "type": "string" },
              "connections": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "isolated_papers": { "type": "array", "items": { "type": "string" } },
        "external_hubs": { "type": "array", "items": { "$ref": "#/$defs/PaperSummaryRef" } }
      },
      "additionalProperties": false
    },
    "RelatedPapers": {
      "type": "object",
      "required": ["papers", "total_candidates"],
      "properties": {
        "papers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recid", "title", "authors", "relevance_score", "relevance_reason", "connection_count"],
            "properties": {
              "recid": { "type": "string" },
              "title": { "type": "string" },
              "authors": { "type": "array", "items": { "type": "string" } },
              "year": { "type": "number" },
              "citation_count": { "type": "number" },
              "relevance_score": { "type": "number" },
              "relevance_reason": { "type": "string" },
              "connection_count": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "total_candidates": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ExpansionResult": {
      "type": "object",
      "required": ["direction", "papers"],
      "properties": {
        "direction": { "type": "string" },
        "papers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recid", "title", "authors", "connection_strength", "connection_path", "already_in_library"],
            "properties": {
              "recid": { "type": "string" },
              "title": { "type": "string" },
              "authors": { "type": "array", "items": { "type": "string" } },
              "year": { "type": "number" },
              "citation_count": { "type": "number" },
              "connection_strength": { "type": "number" },
              "connection_path": { "type": "array", "items": { "type": "string" } },
              "already_in_library": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "emerging_topics": { "type": "array", "items": { "$ref": "#/$defs/PaperSummaryRef" } }
      },
      "additionalProperties": false
    },
    "SurveyResult": {
      "type": "object",
      "required": ["goal", "sections", "suggested_reading_order"],
      "properties": {
        "goal": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "papers"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "papers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["recid", "title", "authors", "why_include", "priority", "is_review"],
                  "properties": {
                    "recid": { "type": "string" },
                    "title": { "type": "string" },
                    "authors": { "type": "array", "items": { "type": "string" } },
                    "year": { "type": "number" },
                    "citation_count": { "type": "number" },
                    "why_include": { "type": "string" },
                    "priority": { "$ref": "#/$defs/SurveyPriority" },
                    "is_review": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "suggested_reading_order": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "TopicMetadataQuery": {
      "type": "object",
      "required": [
        "status",
        "query",
        "requested_page_size",
        "returned_count",
        "sample_complete",
        "has_more"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "requested_page_size": {
          "type": "integer",
          "minimum": 1
        },
        "sort": {
          "type": "string"
        },
        "returned_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_more": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "next_url": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TopicEvolution": {
      "type": "object",
      "required": [
        "topic",
        "time_range",
        "time_range_basis",
        "phases",
        "current_status",
        "sample_basis",
        "coverage"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "time_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "time_range_basis": {
          "type": "string",
          "enum": [
            "requested_start",
            "default_20_year_lookback"
          ]
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "period",
              "time_range",
              "paper_count",
              "publication_count_change",
              "key_papers",
              "key_authors",
              "search"
            ],
            "properties": {
              "period": {
                "type": "string"
              },
              "time_range": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "paper_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "publication_count_change": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "previous_period",
                  "previous_paper_count",
                  "fraction"
                ],
                "properties": {
                  "previous_period": {
                    "type": "string"
                  },
                  "previous_paper_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fraction": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "key_papers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/PaperSummaryRef"
                }
              },
              "key_authors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "search": {
                "$ref": "#/$defs/TopicMetadataQuery"
              }
            },
            "additionalProperties": false
          }
        },
        "current_status": {
          "type": "object",
          "required": [
            "recent_papers",
            "time_range",
            "search"
          ],
          "properties": {
            "recent_papers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "time_range": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "search": {
              "$ref": "#/$defs/TopicMetadataQuery"
            }
          },
          "additionalProperties": false
        },
        "sample_basis": {
          "type": "object",
          "required": [
            "papers",
            "key_papers_limit",
            "key_authors"
          ],
          "properties": {
            "papers": {
              "const": "single_mostcited_page_per_period",
              "type": "string"
            },
            "key_papers_limit": {
              "const": 5,
              "type": "integer"
            },
            "key_authors": {
              "const": "occurrences_among_first_three_authors_of_sampled_papers",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "required": [
            "period_queries",
            "paper_samples"
          ],
          "properties": {
            "period_queries": {
              "type": "string",
              "enum": [
                "complete",
                "partial"
              ]
            },
            "paper_samples": {
              "type": "string",
              "enum": [
                "complete",
                "partial"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "BatchImportResult": {
      "type": "object",
      "required": ["total", "imported", "skipped", "failed", "details"],
      "properties": {
        "total": { "type": "number" },
        "imported": { "type": "number" },
        "skipped": { "type": "number" },
        "failed": { "type": "number" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recid", "status"],
            "properties": {
              "recid": { "type": "string" },
              "status": { "$ref": "#/$defs/ImportStatus" },
              "zotero_key": { "type": "string" },
              "error": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "collection_key": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
